{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-main",
  "description": "Minimal desktop bridge for the bundled XHarness loopback UI",
  "webviews": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "allow-desktop-status",
    "allow-desktop-report-startup-phase",
    "allow-desktop-open-diagnostics",
    "allow-desktop-check-update",
    "allow-desktop-update-status",
    "allow-desktop-download-update",
    "allow-desktop-install-update",
    "allow-desktop-set-computer-activity",
    "allow-desktop-browser-navigate",
    "allow-desktop-browser-activate",
    "allow-desktop-browser-bounds",
    "allow-desktop-browser-action",
    "allow-desktop-browser-close",
    "allow-desktop-browser-restore",
    "allow-desktop-browser-persist"
  ]
}
