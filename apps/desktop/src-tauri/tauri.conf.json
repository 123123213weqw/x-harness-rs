{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XHarness",
  "version": "0.1.0",
  "identifier": "com.xlang.xharness",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XHarness",
        "url": "index.html",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["desktop-main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/xharness-host", "binaries/rg"],
    "resources": {
      "../../../ui/dist/": "web/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
