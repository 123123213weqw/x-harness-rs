{
  "manifest_version": 3,
  "name": "XHarness Browser",
  "version": "0.1.0",
  "minimum_chrome_version": "123",
  "description": "Connect explicitly authorized browser tabs to XHarness without taking over your desktop.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "XHarness Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
